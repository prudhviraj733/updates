{
  "expo": {
    "name": "SavingSmart",
    "slug": "bestkart-grocery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bestkart",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.bestkart.app"
    },
    "android": {
      "package": "in.bestkart.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1B4332"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      ["expo-notifications", { "color": "#1B4332" }],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://bestkart.in",
      "eas": { "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID" }
    }
  }
}
